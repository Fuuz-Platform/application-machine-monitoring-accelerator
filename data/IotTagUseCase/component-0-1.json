{
  "api": "application",
  "modelName": "IotTagUseCase",
  "payload": [
    {
      "id": "Event",
      "name": "Event",
      "usable": true,
      "description": "A tag used to signal that a certian event has happened on the machine.\n\nThe value of this tag should correspond to the plcCode field on the eventList in an event group.",
      "configurationSchema": {
        "type": "object",
        "properties": {
          "workcenter": {
            "type": "object",
            "inputProps": {
              "type": "combobox",
              "padding": 8,
              "width": "100%",
              "height": "auto",
              "label": "Combobox",
              "multiselect": false,
              "isClearable": true,
              "api": "Application",
              "validation": {
                "required": false
              },
              "visible": true,
              "formElement": "Form1",
              "labelField": "code",
              "labelPath": "code",
              "orderByField": "code",
              "stateTracking": "full",
              "additionalFields": "modeGroupId",
              "query": {
                "fields": [
                  "id",
                  "code"
                ]
              },
              "queryType": "Workcenter"
            }
          }
        }
      }
    },
