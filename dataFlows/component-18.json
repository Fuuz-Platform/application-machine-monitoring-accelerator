        {
          "id": "5d547549-9a81-4d26-bfa6-71d45b75c754",
          "name": "Workcenter Query",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "$",
            "query": "query (\n  $workcenterId: String!,\n  $startAt : DateTime,\n  $endAt: DateTime\n){\n  productionRun(\n    where:{\n      workcenterId:{ _eq: $workcenterId}\n      endAt:{ _isNull: true}\n    }\n  ){\n    edges{\n      node{\n        id\n        number\n        counterAccum\n        actualLaborHours\n        availability\n        averageCycleTime\n        changeoverAggregate\n        changeoverTime\n        crewAggregate\n        duration\n        earnedLaborHours\n        earnedMachineHours\n        excludedProduction\n        excludedScrap\n        idealAggregate\n        oee\n        performance\n        plannedDowntime\n        produced\n        quality\n        runCrewSize\n        runTime\n        totalScrapQuantity : scrap\n        standardAggregate\n        totalProductionQuantity : totalProduction\n        totalRequired\n        unplannedDowntime\n        externalId\n        endAt\n        startAt\n        customData\n        productionSetupId\n        unitId\n        workcenterId\n      }\n    }\n  }\n  \n  workcenterHistory(\n      where:{ \n        _or:[\n          {\n            _and:[\n              { occurAt:{_gte: $startAt} }\n              { occurAt:{_lt: $endAt} }\n              { workcenterId:{ _eq: $workcenterId}}\n            ]\n          },\n          {\n            _and:[\n              { endAt:{_gte: $startAt} }\n              { endAt:{_lt: $endAt} }\n              { workcenterId:{ _eq: $workcenterId}}\n            ]\n          },\n          { _and: [\n            {endAt: { _isNull: true }}\n            {occurAt: {_gte: $startAt }}\n            {occurAt: {_lt: $endAt }}\n            {workcenterId:{ _eq: $workcenterId}}\n            ]\n          }\n        ]\n      }\n      orderBy: {field: occurAt,  direction: asc}\n    ) {\n      edges {\n        node {\n          id\n          occurAt\n          endAt\n          duration\n          transactionTypeId\n          workcenterId\n          mode{\n              id\n              name\n              modeType{\n                name\n              }            \n            }\n\n        }\n      }\n    }\n  \n  productionHistory(\n    where:{\n      workcenterId:{_eq: $workcenterId }\n      occurAt:{\n        _gte: $startAt\n        _lt: $endAt\n      }\n    }\n    orderBy: {field: occurAt,  direction: asc}\n  ) {\n    edges {\n      node {\n        transactionTypeId\n        occurAt(round:{unit: hour})\n        _aggregate{\n          quantity{\n            sum\n            \n          }\n        }\n      }\n    }\n  }\n  \n  modeType{\n    edges{\n      node{\n        name\n      }\n    }\n  }\n}",
            "nextNodes": [
              "f6d7fb3a-4b70-432f-bd4c-ed1ed4ad9674"
            ]
          },
