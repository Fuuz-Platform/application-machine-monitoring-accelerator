      "type": "System",
      "nodes": [
        {
          "id": "05154588-95bb-4902-b226-1d4dc6694f89",
          "name": "Get Distibutions and current outputs",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{\n  \"workcenterId\": workcenterId,\n  \"ids\": distributions\n}",
            "query": "query ($ids: [String!]!,  $workcenterId: String!) {\n workOrderProcessDistribution(where: {id: {_in: $ids}}) {\n    total\n    edges {\n      node {\n        id\n        label: number\n        balanceQuantity\n        cycleTime\n        duration\n        idealRate\n        producedQuantity\n        productionOperators\n        requiredQuantity\n        scrappedQuantity\n        setupOperators\n        setupRate\n        standardRate\n        batchCriteria\n        distributionStatus\n        externalId\n        jobId\n        jobOperationId\n        operationCode\n        operationNumber\n        priority\n        processType\n        productId\n        productNumber\n        productNumberRevision\n        productOperationType\n        productRevision\n        unitOfMeasure\n        workOrderNumber\n        workOrderStatus\n        workOrderType\n        actualFinishAt\n        actualStartAt\n        jobDueAt\n        jobEarliestStartAt\n        operationDueAt\n        scheduledFinishAt\n        scheduledStartAt\n        customData\n        workcenterId\n        facilityId\n        productionRunId\n      }\n    }\n  }\n productionSetupOutput(where: {workcenterId:{_eq: $workcenterId}}){\n    edges{\n      node{\n        id\n        workcenterId\n      }\n    }\n  }\n productionSetup(where: {workcenterId:{_eq: $workcenterId}}){\n\t\tedges{\n      node{\n        id\n      }\n    }\n\t}\n}\n",
            "nextNodes": [
              "95e5383e-e094-4933-896e-e637302d3eaf"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "95e5383e-e094-4933-896e-e637302d3eaf",
          "name": "Prepare Payload",
          "type": "transform",
          "data": {
            "transform": "{\n  \"createPayload\": [(workOrderProcessDistribution.edges.node)#$i.(\n    $number := $i;\n    $data := {\n      \"id\": workcenterId & \"::\" & ($number+1),\n      \"workcenterId\": workcenterId,\n      \"productionSetupId\": $$.productionSetup.edges.node.id,\n      \"workOrderNumber\": workOrderNumber,\n      \"productRevision\": productRevision,\n      \"productNumber\": productNumber,\n      \"productNumberRevision\": productNumberRevision,\n      \"productId\": productId,\n      \"operationNumber\": operationNumber,\n      \"operationCode\": operationCode,\n      \"distributionStatus\": distributionStatus,\n      \"containerType\": null,  /*Container Type is not on the workorder*/\n      \"standardQuantity\": standardQuantity,\n      \"producedQuantity\": producedQuantity,\n      \"remainingBalance\": balanceQuantity,\n      \"distributionQuantity\": requiredQuantity,\n      \"startAt\": null, /* $state.context.workcenterSetupEntries.setupDateTime, */\n      \"productOperationId\": null,/*$state.context.workcenterSetupEntries.parentPartOperationId,  Not in Fuuz*/\n      \"idealRate\": idealRate,\n      \"standardRate\": standardRate,\n      \"setupRate\": setupRate,\n      \"outputId\": $number+1,\n      \"productionOperators\": $coalesce([productionOperators, 0]),\n      \"approvedWorkcenterId\": $hash(\"SHA256\", $join([workcenterId, productNumberRevision, operationCode,operationNumber], \"::\")) \n    };\n\n    {\n      \"create\": $data\n    }\n\n  )],\n  \"deletePayload\": [productionSetupOutput.edges.node.{\n    \"where\":{ \"id\": id}\n  }]\n}\n\n",
            "nextNodes": [
              "391ee194-07bc-4166-9949-8c35a59b80f7"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "391ee194-07bc-4166-9949-8c35a59b80f7",
          "name": "Mutate",
          "type": "mutate",
          "data": {
            "api": "Application",
            "variablesTransform": "$",
            "mutation": "mutation (\n  $deletePayload: [ProductionSetupOutputDeletePayloadInput!]!,\n  $createPayload: [ProductionSetupOutputCreatePayloadInput!]!\n){\n  deleteProductionSetupOutput(payload: $deletePayload){ id }\n  createProductionSetupOutput(payload: $createPayload){ id }\n}",
            "nextNodes": [
