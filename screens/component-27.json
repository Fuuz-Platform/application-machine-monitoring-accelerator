                        "pre": "(\n  $payload := $merge([\n    $omit($components.Form1.data, [\"id\", \"total\", \"edges\"]),\n    {\n      \"shiftGroupId\": $metadata.urlParameters.shiftGroupId\n    },\n   {\n      \"startHour\": $moment($components.Form1.data.startAt).hour()?\n        $moment($components.Form1.data.startAt).utc().hour() :\n        $moment($components.Form1.data.startAt, \"HH:mm\").hour(),\n\n      \"startMinute\": $moment($components.Form1.data.startAt).hour()?\n        $moment($components.Form1.data.startAt).utc().minute() :\n        $moment($components.Form1.data.startAt, \"HH:mm\").minute(),\n\n      \"endHour\": $moment($components.Form1.data.endAt).hour()?\n        $moment($components.Form1.data.endAt).utc().hour() :\n        $moment($components.Form1.data.endAt, \"HH:mm\").hour(),\n\n      \"endMinute\": $moment($components.Form1.data.endAt).hour()?\n        $moment($components.Form1.data.endAt).utc().minute() :\n        $moment($components.Form1.data.endAt, \"HH:mm\").minute()\n\n    }\n  ]);\n    \n  {\n    \"payload\":{\n      \"where\":{\n        \"id\": $metadata.urlParameters.id? $metadata.urlParameters.id : $cuid()\n      },\n      \"update\":$payload,\n      \"create\": $payload\n    }\n    \n  }\n\n)",
                        "post": "$components.Screen.fn.return()"
                      },
