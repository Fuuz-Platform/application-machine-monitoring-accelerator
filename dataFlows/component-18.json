        {
          "id": "ef03ada8-dcf8-4d92-8887-07c1858e5bc6",
          "name": "Production Run Query",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "$",
            "query": "query ProductionRun($workcenterId: String!){\n  \tproductionRun(\n    where:{\n      workcenterId:{ _eq: $workcenterId}\n      endAt:{ _isNull: true}\n    }\n  ){\n    edges{\n      node{\n        id\n        number\n        counterAccum\n        actualLaborHours\n        availability\n        averageCycleTime\n        changeoverAggregate\n        changeoverTime\n        crewAggregate\n        duration\n        earnedLaborHours\n        earnedMachineHours\n        excludedProduction\n        excludedScrap\n        idealAggregate\n        oee\n        performance\n        plannedDowntime\n        produced\n        quality\n        runCrewSize\n        runTime\n        totalScrapQuantity : scrap\n        standardAggregate\n        totalProductionQuantity : totalProduction\n        totalRequired\n        unplannedDowntime\n        externalId\n        endAt\n        startAt\n        customData\n        productionSetupId\n        unitId\n        workcenterId\n      }\n    }\n  }\n  setting(\n    where:{\n      id: {_eq: \"TimeZone\"}\n    }\n  ){\n    edges{\n    node{\n    defaultValue\n  }\n  }\n  }\n      \n}",
            "nextNodes": [
              "3c5e7ba5-5941-484e-9630-3ac157575b88"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
