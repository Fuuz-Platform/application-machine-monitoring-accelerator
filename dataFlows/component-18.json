       name\n              modeType{\n                name\n              }            \n            }\n\n        }\n      }\n    }\n  \n  productionHistory(\n    where:{\n      workcenterId:{_eq: $workcenterId }\n      occurAt:{\n        _gte: $startAt\n        _lt: $endAt\n      }\n    }\n    orderBy: {field: occurAt,  direction: asc}\n  ) {\n    edges {\n      node {\n        transactionTypeId\n        occurAt(round:{unit: hour})\n        _aggregate{\n          quantity{\n            sum\n            \n          }\n        }\n      }\n    }\n  }\n  \n  modeType{\n    edges{\n      node{\n        name\n      }\n    }\n  }\n}",
