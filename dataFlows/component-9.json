              "data": {
                "transform": "(\n  $timezone := setting.edges.node.defaultValue;\n  $fitModeToRange := function($startBound, $endBound, $mode){(\n  \n    $modeStart := $coalesce([ $mode.occurAt , $startBound])~>$moment(?) ;\n    $modeEnd := $coalesce([ $mode.endAt, $endBound])~>$moment(?);\n    \n    $endBoundObj := $moment($endBound);\n    $startBoundObj := $moment($startBound);\n  \n    $start := $modeStart.isAfter($startBound)? $modeStart : $startBoundObj;\n    $end := $modeEnd.isBefore($endBound)? $modeEnd : $endBoundObj;\n      \n    $isNilOrEmpty($mode.occurAt) and $isNilOrEmpty($mode.endAt)? \n      $throw(\"Mode has no occurAt or endAt\", $mode) :\n      $merge([\n        $mode,\n        {\"occurAt\": $start.format(), \"endAt\": $end.format(), \"originalTimes\":{\"occurAt\": $modeStart, \"endAt\": $endAt}}\n      ])\n  \n  )};\n  $durationOrNow := function($v){(\n    $end := $moment();\n    $mode := $fitModeToRange($$.startAt, $end.format(), $v);\n    \n    $start := $moment($mode.occurAt);\n    \n    $durationTillNow := $end.diff($start, \"seconds\");\n    \n    $coalesce([$mode.duration, $durationTillNow])\n    \n  )};\n  \n  $history := [ workcenterHistory.edges.node.($fitModeToRange($state.context.REQUEST.start, $state.context.REQUEST.end, $)) ];\n  \n  $legend := {\n    \"item\": eventType.edges.node.{\n      \"label\": name,\n      \"color\": color\n    }\n  };\n  \n  $task := {\n    \"task\": [$history#$i.{\n        \"label\": $coalesce([ event.name, \"No Event\"]),\n        \"processid\": \"1\",\n        \"start\": $moment( occurAt ).tz($timezone).format(\"HH:mm:ss\"),\n        \"end\": $moment( endAt ).tz($timezone).format(\"HH:mm:ss\"),\n        \"bordercolor\": \"#62B58D\",\n        \"color\": $coalesce([ event.eventType.color, \"#ffffff\"]),\n        \"id\": $i + 1\n      }]\n      \n  };\n  \n  $processes := {\n    \"isbold\": \"1\",\n    \"headertext\": \"Workcenter\",\n    \"process\": [\n      {\n        \"label\": workcenterHistory.edges[0].node.workcenter.code,\n        \"id\": \"1\"\n      }\n    ]\n  };\n  \n  $categories := [\n    {\n      \"category\": [\n        {\n          \"start\": $moment($state.context.REQUEST.start).tz($timezone).format(\"HH:mm:ss\"),\n          \"end\": $moment($state.context.REQUEST.end).tz($timezone).format(\"HH:mm:ss\"),\n          \"name\": \"Shift\"\n        }\n      ]\n    }\n  ];\n  \n  {\n    \"chart\": {\n      \"caption\": \"Machine Operating Schedule\",\n      \"theme\": \"candy\",\n      \"dateformat\": \"yyyy-mm-dd\",\n      \"plottooltext\": \"Status for period <b>$start - $end</b> is <b>$label</b>\",\n      \"outputdateformat\": \"hh12:mn ampm\",\n      \"borderColor\": \"#424242\"\n    },\n    \"legend\": $legend,\n    \"tasks\": $task,\n    \"processes\": $processes,\n    \"categories\": $categories\n  }\n)",
