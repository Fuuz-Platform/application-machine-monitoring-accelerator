          "name": "Calculate End Dates",
          "type": "transform",
          "data": {
            "transform": "$groupBy(workcenterHistory.edges.node[$isNil(occurAt)~>$not]^(occurAt), $path(?, \"workcenterId\"))\n~>$mapValues(function($j){\n  $count($j) > 1?(\n    $map($j, function($v, $i, $arr){(\n \n    $arr[$i +1]?(\n     $start := $moment($v.occurAt);\n     $end := $moment($arr[$i +1].occurAt);\n\n     {\n        \"where\":{ \"id\": $v.id},\n        \"update\":{\n          \"endAt\": $end.format(),\n          \"duration\": $end.diff($start, \"seconds\")\n        }\n      }\n    )\n    )})\n  )\n})\n~>$values\n~>$filter($isNil~>$not)\n~>$flatten()\n\n\n",
            "nextNodes": [
              "aeb7cadb-d58a-4c57-987c-d596518bdc0d"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
