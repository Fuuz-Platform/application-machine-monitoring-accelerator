    "flow": {
      "id": "clw86ncjv1mt1015d6bt5eexz",
      "name": "Mode Event Gantt Data from Workcenter History",
      "type": "System",
      "nodes": [
        {
          "id": "19a0ed75-688a-42ba-8cc8-e92735eab06d",
          "name": "Query History",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{\n\n  \"startTime\": $state.context.REQUEST.start,\n  \"endTime\": $state.context.REQUEST.end,\n  \"workcenterId\": $state.context.REQUEST.workcenterId\n \n}",
            "query": "query (\n  $startTime: DateTime!,\n  $endTime: DateTime!,\n  $workcenterId: String!\n){\n  workcenterHistory(\n    where:{ \n      _or:[\n        {\n          _and:[\n            { occurAt:{_gte: $startTime} }\n            { occurAt:{_lt: $endTime} }\n          ]\n        },\n        {\n          _and:[\n            { endAt:{_gte: $startTime} }\n            { endAt:{_lt: $endTime} }\n          ]\n        },\n        { _and: [ \n        \t{endAt: { _isNull: true }}\n          {occurAt: {_gte: $startTime}}\n          {occurAt: {_lt: $endTime}}\n      ]}\n      ]\n      workcenterId:{\n        _eq: $workcenterId\n      }\n    }\n    first: null\n    orderBy: {\n      field:occurAt, direction:asc\n    }\n\t){\n    total\n    edges {\n      node {\n        occurAt\n        endAt\n        transactionTypeId\n        workcenterId\n        workcenter{\n          code\n        }\n        mode {\n          name        \n          modeType {\n            color\n            production\n            maintenance\n            other\n            disabled\n\n            changeover\n          }\n        }\n        event {\n          name\n          eventType {\n            id\n            color\n            name\n          }\n        }\n      }\n    }\n  }\n  \n  eventType{\n    edges{\n      node{ id name color }\n    }\n  }\n  \n    setting(\n    where:{\n      id:{_eq: \"TimeZone\"}\n    }\n  ){\n    edges{\n      node{\n        defaultValue\n      }\n    }\n  }\n}\n",
            "nextNodes": [
              "d48cfa3b-5ee1-4c36-9d48-993bf50585a8"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
