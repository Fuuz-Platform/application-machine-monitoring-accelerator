            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "84b8da67-c925-4dd5-b027-3e72af54227c",
          "name": "Set Context",
          "type": "setContext",
          "data": {
            "nextNodes": [
              "19a0ed75-688a-42ba-8cc8-e92735eab06d"
            ],
            "transform": "$"
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
